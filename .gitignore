# ============================================================================
# CENTRALIZED .gitignore FOR BINGO-AUCTION-TECHNOVIT
# ============================================================================

# ============================================================================
# 1. ENVIRONMENT VARIABLES, SECRETS & API KEYS (CRITICAL)
# ============================================================================
.env
.env.*
!.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# API credentials, secrets & service accounts
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
serviceAccountKey.json
service-account*.json
*secret*
*secrets*
!README.md
*.token
auth_token*

# ============================================================================
# 2. DEPENDENCIES & PACKAGE MANAGER CACHES
# ============================================================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.npm/
.yarn/cache/

# Debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================================
# 3. BUILD OUTPUTS, COMPILED BUNDLES & CACHES
# ============================================================================
dist/
dist-ssr/
build/
out/
**/dist/
**/dist-ssr/
**/build/
**/out/
*.local
.cache/
**/.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
*.zip
*.tar.gz
*.tgz
*.rar

# ============================================================================
# 4. RUNTIME LOGS & TEMPORARY FILES
# ============================================================================
logs/
**/logs/
*.log
*.tmp
*.temp
.temp/
**/.temp/
.pid
*.pid
.seed
*.seed

# ============================================================================
# 5. TESTING & COVERAGE
# ============================================================================
coverage/
**/coverage/
.nyc_output/
*.lcov

# ============================================================================
# 6. IDE, EDITORS & OS METADATA
# ============================================================================
.vscode/
**/.vscode/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
[Dd]esktop.ini